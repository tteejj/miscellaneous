FROM python:3.11-alpine

LABEL description="RPi Local Chat Server - Containerized Version"
LABEL maintainer="RPi Chat"

WORKDIR /app

# Install system dependencies
RUN apk add --no-cache \
    gcc \
    musl-dev \
    jpeg-dev \
    zlib-dev \
    sqlite

# Copy requirements first (layer caching)
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY database.py .
COPY server.py .
COPY templates/ templates/

# Create non-root user first
RUN adduser -D -u 1000 chatuser

# Create data directory and set ownership
RUN mkdir -p /app/data/uploads/thumbnails /app/data/uploads/files && \
    chown -R chatuser:chatuser /app /app/data

# Switch to non-root user
USER chatuser

# Create symlinks as the chatuser
RUN ln -sf /app/data/uploads /app/uploads && \
    ln -sf /app/data/chat.db /app/chat.db

# Volume for persistent data
VOLUME ["/app/data"]

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5000')" || exit 1

# Initialize database if it doesn't exist, then start server
CMD ["sh", "-c", "test -f /app/data/chat.db || python database.py; python server.py"]
