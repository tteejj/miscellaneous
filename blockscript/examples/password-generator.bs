# Password Generator
# Generate secure random passwords

define generatePassword with length, useNumbers, useSymbols
  create list lowercase
  add "a" to lowercase
  add "b" to lowercase
  add "c" to lowercase
  add "d" to lowercase
  add "e" to lowercase
  add "f" to lowercase
  add "g" to lowercase
  add "h" to lowercase
  add "i" to lowercase
  add "j" to lowercase
  add "k" to lowercase
  add "l" to lowercase
  add "m" to lowercase
  add "n" to lowercase
  add "o" to lowercase
  add "p" to lowercase
  add "q" to lowercase
  add "r" to lowercase
  add "s" to lowercase
  add "t" to lowercase
  add "u" to lowercase
  add "v" to lowercase
  add "w" to lowercase
  add "x" to lowercase
  add "y" to lowercase
  add "z" to lowercase

  create list uppercase
  add "A" to uppercase
  add "B" to uppercase
  add "C" to uppercase
  add "D" to uppercase
  add "E" to uppercase
  add "F" to uppercase
  add "G" to uppercase
  add "H" to uppercase
  add "I" to uppercase
  add "J" to uppercase
  add "K" to uppercase
  add "L" to uppercase
  add "M" to uppercase
  add "N" to uppercase
  add "O" to uppercase
  add "P" to uppercase
  add "Q" to uppercase
  add "R" to uppercase
  add "S" to uppercase
  add "T" to uppercase
  add "U" to uppercase
  add "V" to uppercase
  add "W" to uppercase
  add "X" to uppercase
  add "Y" to uppercase
  add "Z" to uppercase

  create list numbers
  add "0" to numbers
  add "1" to numbers
  add "2" to numbers
  add "3" to numbers
  add "4" to numbers
  add "5" to numbers
  add "6" to numbers
  add "7" to numbers
  add "8" to numbers
  add "9" to numbers

  create list symbols
  add "!" to symbols
  add "@" to symbols
  add "#" to symbols
  add "$" to symbols
  add "%" to symbols
  add "^" to symbols
  add "&" to symbols
  add "*" to symbols

  set password to ""

  for i from 1 to length
    set choice to (random from 1 to 4)

    if choice = 1 then
      set idx to (random from 1 to (length of lowercase))
      set char to (item idx of lowercase)
      set password to join password and char
    end

    if choice = 2 then
      set idx to (random from 1 to (length of uppercase))
      set char to (item idx of uppercase)
      set password to join password and char
    end

    if choice = 3 then
      if useNumbers then
        set idx to (random from 1 to (length of numbers))
        set char to (item idx of numbers)
        set password to join password and char
      else
        set idx to (random from 1 to (length of lowercase))
        set char to (item idx of lowercase)
        set password to join password and char
      end
    end

    if choice = 4 then
      if useSymbols then
        set idx to (random from 1 to (length of symbols))
        set char to (item idx of symbols)
        set password to join password and char
      else
        set idx to (random from 1 to (length of uppercase))
        set char to (item idx of uppercase)
        set password to join password and char
      end
    end
  end

  return password
end

say "Password Generator"

ask "Password length (8-32):"
set len to answer

if len < 8 then
  set len to 8
end

if len > 32 then
  set len to 32
end

ask "Include numbers? (yes/no):"
set numsAnswer to answer
set useNums to numsAnswer = "yes"

ask "Include symbols? (yes/no):"
set symAnswer to answer
set useSyms to symAnswer = "yes"

set password to (call generatePassword with len, useNums, useSyms)

say "Your secure password:"
print password

set strength to ""
if len >= 16 then
  set strength to "Strong"
else
  if len >= 12 then
    set strength to "Medium"
  else
    set strength to "Weak"
  end
end

say join "Password strength: " and strength
