FROM python:3.11-alpine

LABEL description="RPi Local Chat Server - Containerized Version"
LABEL maintainer="RPi Chat"

WORKDIR /app

# Install system dependencies
RUN apk add --no-cache \
    gcc \
    musl-dev \
    jpeg-dev \
    zlib-dev \
    sqlite

# Copy requirements first (layer caching)
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy application files
COPY database.py .
COPY server.py .
COPY templates/ templates/

# Create upload directories
RUN mkdir -p uploads/thumbnails uploads/files

# Create volume mount points
VOLUME ["/app/uploads", "/app/chat.db"]

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5000')" || exit 1

# Run as non-root user
RUN adduser -D -u 1000 chatuser && \
    chown -R chatuser:chatuser /app
USER chatuser

# Start server
CMD ["python", "server.py"]
